# Jeunese — environment template
# Copy to .env.local (Next.js) and .env (Prisma CLI). Do not commit secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep true until legal + payment partners approve production invest.
NEXT_PUBLIC_DEMO_MODE=true

# PostgreSQL >= 15. Leave empty to keep the local demo file at data/demo-db.json.
# After you set this, create the tables with: npx prisma db init
# Prisma 8 needs Node.js 22.18 or newer for that command.
DATABASE_URL=

# Clerk (auth adapter) — leave empty for stub mode; never invent secret values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# CLERK_WEBHOOK_SECRET=

# SESSION_SECRET=
# SANDBOX_WEBHOOK_SECRET=sandbox-demo-webhook-secret

# Object storage / email / jobs — deferred
# DOCUMENT_STORAGE_BUCKET=
# RESEND_API_KEY=
# INNGEST_EVENT_KEY=
