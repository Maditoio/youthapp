# Jeunese — environment template
# Copy to .env.local (Next.js) and .env (Prisma CLI). Do not commit secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep true until legal + payment partners approve production invest.
# Controls demo banner, demo login accounts, and fictional seed — not sandbox payments alone.
NEXT_PUBLIC_DEMO_MODE=true
# Process-test sandbox payments without demoMode: set true to enable simulate-payment UI,
# sandboxPayAction, and POST /api/webhooks/payments/sandbox. Also on when demoMode is on.
# SANDBOX_PAYMENTS_ENABLED=true

# PostgreSQL >= 15. Leave empty to keep the local demo file at data/demo-db.json.
# After you set this, create the tables with: npx prisma db init
# Prisma 8 needs Node.js 22.18 or newer for that command.
# On Neon, set DATABASE_URL_UNPOOLED (direct host) for the app — the pooler rejects lc_monetary.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (auth adapter) — leave empty for stub mode; never invent secret values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# CLERK_WEBHOOK_SECRET=

# SESSION_SECRET=
# Required for signed sandbox webhook POSTs (HMAC). Default used only in local demo.
# SANDBOX_WEBHOOK_SECRET=sandbox-demo-webhook-secret

# Comma-separated emails that receive platform_admin on Clerk bind (additive; keeps investor).
# ADMIN_EMAILS=you@example.com

# Object storage / email / jobs — deferred
# DOCUMENT_STORAGE_BUCKET=
# RESEND_API_KEY=
# INNGEST_EVENT_KEY=
